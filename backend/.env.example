# ------------------------------------------------------------------
# TradeIQ configuration. Copy to backend/.env for local dev; on Railway
# set these in the service's Variables tab instead.
# ------------------------------------------------------------------

# --- Database ---
# Local dev: run `npm run db:local` and paste the URL it prints.
DATABASE_URL=postgresql://tradeiq:tradeiq-local@localhost:54329/tradeiq
# Optional: owner/superuser URL used ONLY by `npm run migrate` and
# `npm run make-admin`, so the app itself can run as a least-privilege role
# (see db/LeastPrivilegeSetup.sql). Leave unset to use DATABASE_URL for both.
# MIGRATION_DATABASE_URL=

# --- Security (required in production) ---
# Long random string, 32+ chars. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=
# Optional separate secret for signing unit-exam tokens. Defaults to a value
# derived from JWT_ACCESS_SECRET.
# JWT_EXAM_SECRET=

# --- Admin lock ---
# Comma-separated user ids allowed to use the admin panel. Admin access needs
# BOTH this list AND role='admin' in the database (npm run make-admin).
# Empty in production = nobody is admin.
ADMIN_USER_IDS=

# --- App ---
NODE_ENV=development
PORT=3001
# The public URL people use. Email links are built from this.
APP_URL=http://localhost:3001

# --- Email (optional; without it, emails print to the server console) ---
# Create a free account at resend.com, verify your domain, make an API key.
RESEND_API_KEY=
EMAIL_FROM=TradeIQ <hello@yourdomain.com>
# EMAIL_REPLY_TO=you@yourdomain.com

# --- Market data (see docs/MARKET_DATA.md for licensing) ---
# Prices: free Alpaca account -> Paper Trading -> API Keys. Requires Alpaca's
# written consent before showing the data publicly. Without these, the app
# falls back to Yahoo Finance, which is fine for local dev only.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# ALPACA_FEED=iex
# Company financials + filings come from SEC EDGAR (free, public). The SEC
# requires a contact in the User-Agent; CONTACT_EMAIL below is used
# automatically, or override it here.
# SEC_USER_AGENT=TradeIQ education app (you@yourdomain.com)

# --- Legal / site info (shown in the footer, legal pages and every email) ---
SITE_NAME=TradeIQ
LEGAL_ENTITY=TradeIQ
CONTACT_EMAIL=support@yourdomain.com
# CAN-SPAM requires a physical postal address in commercial email
# (streak reminders / digests). A PO box or registered agent address works.
POSTAL_ADDRESS=
# State whose law governs the Terms of Service, e.g. California
GOVERNING_STATE=

# Only if you host the frontend on a different origin than the API:
# CORS_ORIGIN=https://www.yourdomain.com
